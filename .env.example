# ---------------------------------------------------------------------------
# Slotly — booking/scheduling platform for service businesses.
#
# Public vars (safe in the browser) use NEXT_PUBLIC_. Everything else is
# server-only — never expose SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, or TWILIO_AUTH_TOKEN to client code.
# ---------------------------------------------------------------------------

# Supabase (PostgreSQL + Auth + RLS + JWT)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — TEST MODE ONLY per spec (sk_test_…). getEnv() throws on sk_live_.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (booking confirmations, reminders)
RESEND_API_KEY=re_...

# SMS (booking reminders) — gate sending on NEXT_PUBLIC_ENABLE_SMS
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...
NEXT_PUBLIC_ENABLE_SMS=false

# App
APP_URL=http://localhost:3000
CRON_SECRET=generate-a-long-random-secret
